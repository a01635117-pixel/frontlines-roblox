-- Loads a packed map module (generated by tools/pack-map.mjs) into GameMaps.
-- Counterpart of OpenFrontIO's loadTerrainMap() for GameMapSize.Compact.
--
-- Each call decodes fresh buffers, so the returned GameMaps are independent
-- (the simulation mutates terrain, e.g. setWater after nukes).

local EncodingService = game:GetService("EncodingService")

local GameMap = require(script.Parent.GameMap)

local MapLoader = {}

local function decodeTerrain(b64: string, width: number, height: number, label: string): buffer
	local compressed = EncodingService:Base64Decode(buffer.fromstring(b64))
	local expected = width * height
	local size = EncodingService:GetDecompressedBufferSize(compressed, Enum.CompressionAlgorithm.Zstd)
	if size ~= expected then
		error(`{label}: decompressed size {size} doesn't match {width}x{height}`)
	end
	return EncodingService:DecompressBuffer(compressed, Enum.CompressionAlgorithm.Zstd)
end

-- Returns gameMap, miniGameMap, manifest (the module's table minus terrain).
function MapLoader.load(mapModule: ModuleScript)
	local data = require(mapModule) :: any
	local gameMap = GameMap.new(
		data.width,
		data.height,
		decodeTerrain(data.terrain, data.width, data.height, `{data.id}/map4x`),
		data.numLandTiles
	)
	local miniGameMap = GameMap.new(
		data.miniWidth,
		data.miniHeight,
		decodeTerrain(data.miniTerrain, data.miniWidth, data.miniHeight, `{data.id}/map16x`),
		data.miniNumLandTiles
	)
	local manifest = {
		id = data.id,
		name = data.name,
		categories = data.categories,
		nations = data.nations,
		additionalNations = data.additionalNations,
		teamGameSpawnAreas = data.teamGameSpawnAreas,
	}
	return gameMap, miniGameMap, manifest
end

return MapLoader
