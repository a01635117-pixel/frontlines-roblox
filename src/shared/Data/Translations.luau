	{ key = "player_panel.traitor", source = "Traitor", values = { ["pl"] = "Zdrajca", ["de"] = "Verräter", ["fr"] = "Traître", ["pt"] = "Traidor", ["ru"] = "Предатель", ["ja"] = "裏切り者かどうか", ["ko"] = "배신자", ["vi"] = "Kẻ phản bội", ["zh-tw"] = "叛徒" } },
	{ key = "tutorial.step.traitor_info", source = "Traitors get a large defense debuff for 30 seconds, so be careful.", values = { ["pl"] = "Zdrajcy mają przez 30 sekund dużo słabszą obronę, więc uważaj.", ["de"] = "Verräter erhalten für 30 Sekunden einen starken Verteidigungs‑Debuff, also sei vorsichtig.", ["fr"] = "Les traîtres subissent une forte pénalité de défense pendant 30 secondes, alors soyez prudent.", ["ru"] = "Предатели наказываются крупным снижением защиты на 30 секунд. Будьте осторожны.", ["ja"] = "裏切り者になると30秒間、防御力が大幅に低下します。注意してください。", ["ko"] = "배신자는 30초 동안 큰 방어 디버프를 받으므로 주의하세요.", ["vi"] = "Kẻ phản bội sẽ bị giảm mạnh phòng thủ trong 30 giây, nên hãy cẩn thận.", ["zh-tw"] = "叛徒會得到 30 秒嚴重的防禦負面狀態，所以請小心。" } },
