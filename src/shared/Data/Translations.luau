	{ key = "tutorial.step.mirv_info", source = "MIRV — a massive missile attack to cripple your enemy.", values = { ["pl"] = "MIRV – potężny atak rakietowy, który rujnuje wroga.", ["de"] = "MIRV — ein massiver Raketenangriff, der deinen Feind schwer lähmt.", ["fr"] = "MIRV, une attaque massive de bombes atomiques destinée à affaiblir lourdement et rapidement l’ennemi.", ["ru"] = "РГЧ ИН — массированный ракетный удар, наносящий сокрушительный урон врагу.", ["ja"] = "MIRV ― 敵に大打撃を与える大規模なミサイル攻撃です。", ["ko"] = "다탄두 미사일 — 적을 무력화하는 대규모 미사일 공격입니다.", ["vi"] = "MIRV — đòn tấn công tên lửa quy mô lớn, làm tê liệt kẻ địch.", ["zh-tw"] = "MIRV（分導式多彈頭）──可以嚴重削弱敵人的一種大型飛彈攻擊。" } },
