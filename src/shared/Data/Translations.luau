	{ key = "tutorial.step.factory_info", source = "Factories are connected to cities and other factories by tracks, and spawn trains that grant gold.", values = { ["pl"] = "Fabryki łączą się torami z miastami i innymi fabrykami i wysyłają pociągi, które dają złoto.", ["de"] = "Fabriken sind über Gleise mit Städten und anderen Fabriken verbunden und erzeugen Züge, die Gold bringen.", ["fr"] = "Les usines sont reliées aux villes, aux ports, et aux autres usines par des rails et font apparaître des trains qui rapportent de l’or.", ["ru"] = "Фабрики соединяются с городами и другими фабриками с помощью путей. Они создают поезда, которые приносят золото.", ["ja"] = "工場は線路で都市や他の工場と接続され、資金をもたらす列車を生成します。", ["ko"] = "공장은 선로를 통해 도시 및 다른 공장과 연결되며, 금을 지급하는 기차를 생성합니다.", ["vi"] = "Nhà máy được kết nối với các thành phố và nhà máy khác bằng đường ray, đồng thời tạo ra tàu hỏa để mang về vàng.", ["zh-tw"] = "工廠藉由鐵路連接至城市和其他工廠，並可生成火車來幫您獲得黃金。" } },
	{ key = "unit_type.factory", source = "Factory", values = { ["pl"] = "Fabryka", ["de"] = "Fabrik", ["fr"] = "Usine", ["pt"] = "Industria", ["ru"] = "Фабрика", ["ja"] = "工場", ["ko"] = "공장", ["vi"] = "Nhà Máy", ["zh-tw"] = "工廠" } },
	{ key = "map.featured", source = "Featured", values = { ["pl"] = "Polecane", ["de"] = "Empfohlen", ["fr"] = "En vedette", ["pt"] = "Em Destaque", ["ru"] = "Рекомендованные", ["ja"] = "おすすめ", ["ko"] = "추천", ["vi"] = "Nổi bật", ["zh-tw"] = "精選" } },
	{ key = "tutorial.step.buy_silo", source = "Finally, build a Missile Silo: press {key}, then click your territory to place it. Silos launch atom bombs, hydrogen bombs and MIRVs.", values = { ["pl"] = "Na koniec zbuduj Silos rakietowy: naciśnij {key}, a potem kliknij swoje terytorium. Silosy wystrzeliwują bomby atomowe, wodorowe i MIRV-y.", ["de"] = "Zum Schluss baust du ein Raketensilo: Drücke {key} und klicke dann auf dein Territorium, um es zu platzieren. Silos starten Atombomben, Wasserstoffbomben und MIRVs.", ["fr"] = "Enfin, construisez un Silo à missiles : appuyez sur {key}, puis cliquez sur votre territoire pour le placer. Les silos permettent de lancer des bombes atomiques, des bombes à hydrogène et des MIRVs.", ["ru"] = "И наконец, постройте ракетную шахту: нажмите {key}, а затем кликните по своей территории, чтобы разместить её. Шахты запускают атомные и водородные бомбы, а также РГЧ ИН.", ["ja"] = "ミサイルサイロを建設しましょう。{key}を押してから、自分の領土を左クリックして建設してください。ミサイルサイロから原子爆弾、水素爆弾、MIRVを発射できます。", ["ko"] = "마지막으로 미사일 발사대를 건설하세요: {key} 키를 누른 다음, 영토를 클릭하여 배치하세요. 사일로에서는 원자폭탄, 수소폭탄, 다탄두 미사일(MIRV)을 발사할 수 있습니다.", ["vi"] = "Cuối cùng, hãy xây Hầm phóng tên lửa: nhấn {key}, sau đó bấm vào lãnh thổ của bạn để đặt nó. Hầm phóng tên lửa dùng để phóng tên lửa bom nguyên tử, tên lửa bom nhiệt hạch (bom hydro) và MIRV.", ["zh-tw"] = "最後，建造一個飛彈發射井：按 {key}，然後點擊在您的領土即可建造。發射井可以發射核彈、氫彈、以及 MIRV（分導式多彈頭）。" } },
	{ key = "tutorial.step_touch.buy_silo", source = "Finally, build a Missile Silo: tap your territory, open the wrench menu and pick Missile Silo. Silos launch atom bombs, hydrogen bombs and MIRVs.", values = { ["pl"] = "Na koniec zbuduj Silos rakietowy: dotknij terytorium, otwórz menu klucza i wybierz Silos rakietowy. Silosy wystrzeliwują bomby atomowe, wodorowe i MIRV-y.", ["de"] = "Zum Schluss baust du ein Raketensilo: Tippe auf dein Gebiet, öffne das Schraubenschlüssel‑Menü und wähle ‚Raketensilo‘. Silos starten Atombomben, Wasserstoffbomben und MIRVs.", ["fr"] = "Enfin, construisez un Silo à missiles : touchez votre territoire, ouvrez le menu Construction, puis sélectionnez l'icône de missile. Les silos permettent de lancer des bombes atomiques, des bombes à hydrogène et des MIRV.", ["ru"] = "И наконец, постройте ракетную шахту: коснитесь своей территории, откройте меню с гаечным ключом и выберите «Ракетная шахта». Шахты запускают атомные и водородные бомбы, а также РГЧ ИН.", ["ja"] = "最後に、ミサイルサイロを建設しましょう：あなたの領土を右クリックして円形メニューを開き、ミサイルサイロを選択しましょう。ミサイルサイロは原子爆弾、水素爆弾、MIRVを発射します。", ["ko"] = "마지막으로 미사일 발사대를 건설하세요: 영토를 탭하고 렌치 메뉴를 연 다음 미사일 발사대를 선택하세요. 발사대에서는 원자 폭탄, 수소 폭탄, 다탄두 미사일을 발사할 수 있습니다.", ["vi"] = "Cuối cùng, hãy xây Hầm phóng tên lửa: nhấn vào lãnh thổ của bạn, mở menu hình cờ lê và chọn Hầm phóng tên lửa. Hầm phóng tên lửa dùng để phóng bom nguyên tử, bom nhiệt hạch (bom hydro) và MIRV.", ["zh-tw"] = "最後，建造一個飛彈發射井：點擊您的領土，開啟扳手選單並選擇飛彈發射井。發射井可以發射核彈、氫彈、以及 MIRV（分導式多彈頭）。" } },
