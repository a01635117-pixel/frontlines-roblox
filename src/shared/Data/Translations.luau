	{ key = "tutorial.step.port_info_warships", source = "Ports can also be used to construct warships.", values = { ["pl"] = "W portach można też budować okręty wojenne.", ["de"] = "Häfen können auch zum Bau von Kriegsschiffen verwendet werden.", ["fr"] = "Les ports permettent également de construire des navires de guerre.", ["ru"] = "Порты могут быть использованы для постройки военных кораблей.", ["ja"] = "港では戦艦を発艦することもできます。", ["ko"] = "항구는 군함을 건조하는 데에도 사용됩니다.", ["vi"] = "Cảng cũng có thể được dùng để đóng tàu chiến.", ["zh-tw"] = "港口也可以用來建造軍艦。" } },
	{ key = "tutorial.step.port_info_ships", source = "Ports send out trade ships, which earn you gold.", values = { ["pl"] = "Porty wysyłają statki handlowe, które przynoszą złoto.", ["de"] = "Häfen schicken Handelsschiffe los, die dir Gold einbringen.", ["fr"] = "Les ports envoient des bateaux de commerce qui vous rapportent de l’or.", ["ru"] = "Порты отправляют торговые корабли, которые зарабатывают золото.", ["ja"] = "港から貿易船が出航し、資金を獲得できます。", ["ko"] = "항구는 무역선을 출항시켜 금을 벌어다 줍니다.", ["vi"] = "Cảng gửi tàu thương mại ra khơi, giúp bạn kiếm vàng.", ["zh-tw"] = "港口可以派出商船，並為您獲得黃金。" } },
