	{ key = "control_panel.low_troops_warning", source = "You are very low on troops - You should always keep some troops for defense.", values = { ["pl"] = "Masz bardzo mało wojska – zawsze zostaw trochę żołnierzy do obrony.", ["de"] = "Du hast sehr wenige Truppen - Du solltest immer Truppen zur Verteidigung behalten.", ["fr"] = "Vous avez très peu de troupes - Vous devriez toujours garder des troupes pour la défense.", ["pt"] = "Você esta com muito pouco tropas — Você sempre deve deixar algumas para defender-se.", ["ru"] = "У вас малое количество войск. Всегда следует оставлять некоторое количество для обороны.", ["ja"] = "兵力が残りわずかです。防衛のため、兵力を常に一部残しておきましょう。", ["ko"] = "병력이 매우 부족합니다. 항상 방어용 병력을 일부 남겨두어야 합니다.", ["vi"] = "Bạn còn rất ít quân. Hãy luôn giữ lại một ít lính để phòng thủ.", ["zh-tw"] = "你的部隊很少 - 請務必保留一些部隊用於防守。" } },
	{ key = "events_display.betrayal_description", source = "You broke your alliance with {name}, making you a TRAITOR ({malusPercent}% defense debuff for {durationText})", values = { ["pl"] = "Zerwałeś sojusz z {name} i jesteś teraz ZDRAJCĄ (obrona -{malusPercent}% przez {durationText})", ["de"] = "Du hast deine Allianz mit {name} gebrochen und bist zum VERRÄTER geworden ({malusPercent}% Verteidigungs-Malus für {durationText})", ["fr"] = "Vous avez rompu votre alliance avec {name}, ce qui fait de vous un TRAÎTRE (affaiblissement de défense de {malusPercent}% pendant {durationText})", ["pt"] = "Você quebrou a sua aliança com {name}, fazendo de você um TRAIDOR ({malusPercent}% debuff de defesa por {durationText})", ["ru"] = "Вы порвали союз с {name}, став ПРЕДАТЕЛЕМ (защита снижена на {malusPercent}% на {durationText})", ["ja"] = "あなたは{name}との同盟を破棄し、裏切り者になりました（防御力が{durationText}の間{malusPercent}%低下します）", ["ko"] = "{name}와의 동맹을 파기했습니다. 당신은 이제 배신자입니다. (방어력 {malusPercent}% 감소, 지속 시간: {durationText})", ["vi"] = "Bạn đã phá vỡ liên minh với {name}, khiến bạn trở thành KẺ PHẢN BỘI (giảm {malusPercent}% phòng thủ trong {durationText})", ["zh-tw"] = "你已撕毀和 {name} 的盟約，因而被標記為“叛徒”（你將獲得 {durationText} 的 {malusPercent}% 防禦降低懲罰）" } },
	{ key = "tutorial.step.buy_city", source = "You can afford a City! Press {key} (or click the City icon under the control panel), then click your territory to place it. Cities raise your max troops.", values = { ["pl"] = "Stać cię na Miasto! Naciśnij {key} (albo kliknij ikonę Miasta pod panelem), a potem kliknij swoje terytorium, aby je postawić. Miasta zwiększają limit wojska.", ["de"] = "Du kannst dir eine Stadt leisten! Drücke {key} (oder klicke auf das Stadt‑Symbol unter dem Kontrollpanel) und klicke dann auf dein Territorium, um sie zu platzieren. Städte erhöhen deine maximale Truppenanzahl.", ["fr"] = "Vous pouvez construire une Ville ! Appuyez sur {key} (ou cliquez sur l’icône Ville sous le panneau de contrôle), puis cliquez sur votre territoire pour la placer. Les Villes augmentent votre capacité maximale de troupes par 25k.", ["ru"] = "Вам хватает на покупку города! Нажмите {key} (или по иконке города под панелью управления), затем кликните по своей территории, чтобы разместить его. Города увеличивают лимит войск.", ["ja"] = "都市を建設できる資金が貯まりましたね！{key}を押すか、下にある操作パネルの都市アイコンをクリックしてから、自分のどこかの領土に左クリックして建設しましょう。都市を建設すると兵力上限が増加します。", ["ko"] = "도시를 건설할 수 있습니다! {key} 키를 누르거나(또는 제어판 아래의 도시 아이콘 클릭), 영토를 클릭하여 배치하세요. 도시는 최대 병력을 늘려줍니다.", ["vi"] = "Bạn đã đủ tiền xây Thành phố! Nhấn {key} (hoặc bấm biểu tượng Thành phố dưới bảng điều khiển), sau đó bấm vào lãnh thổ của bạn để đặt nó. Thành phố giúp tăng số quân tối đa của bạn.", ["zh-tw"] = "您可以購買一座城市了！按 {key}（或點擊控制面板下的城市圖示），並在您的領土上點擊放置。城市將會提升您的最大軍隊數。" } },
	{ key = "tutorial.step_touch.buy_city", source = "You can afford a City! Tap your territory, open the wrench (Build) menu and pick City. Cities raise your max troops.", values = { ["pl"] = "Stać cię na Miasto! Dotknij swojego terytorium, otwórz menu klucza (Budowa) i wybierz Miasto. Miasta zwiększają limit wojska.", ["de"] = "Du kannst dir eine Stadt leisten! Tippe auf dein Territorium, öffne das Schraubenschlüssel‑ (Bauen‑) Menü und wähle ‚Stadt‘. Städte erhöhen deine maximale Truppenanzahl.", ["fr"] = "Vous pouvez construire une Ville ! Touchez votre territoire, ouvrez le menu Construction (clé à molette), puis sélectionnez l'icône d'immeuble. Les Villes augmentent votre nombre maximal de troupes de 25k.", ["ru"] = "Вам хватает на покупку города! Коснитесь своей территории, откройте меню (строительства) с гаечным ключом и выберите «Город». Города увеличивают лимит войск.", ["ja"] = "都市を建設できる資金が貯まりました！自分の領土を右クリックして円形メニューを開き、「都市」を選択してください。都市を建設すると兵力上限が増加します。", ["ko"] = "도시를 건설할 수 있습니다! 영토를 탭하고 렌치(건설) 메뉴를 연 다음 도시를 선택하세요. 도시는 최대 병력을 늘려줍니다.", ["vi"] = "Bạn đã đủ tiền xây Thành phố! Nhấn vào lãnh thổ của bạn, mở menu hình cờ lê (Xây dựng) và chọn Thành phố. Thành phố giúp tăng số quân tối đa của bạn.", ["zh-tw"] = "您可以購買一座城市了！點擊您的領土，開啟扳手（建造）選單並選擇城市即可放置。城市將會提升您的最大軍隊數。" } },
	{ key = "win_modal.died", source = "You died", values = { ["pl"] = "Zginąłeś", ["de"] = "Du bist gestorben", ["fr"] = "Vous êtes mort·e.", ["pt"] = "Você Morreu", ["ru"] = "Вы погибли", ["ja"] = "あなたは死んでしまった", ["ko"] = "죽었습니다", ["vi"] = "Bạn đã chết", ["zh-tw"] = "你已經死了" } },
	{ key = "tutorial.step.no_coast", source = "You have no coastline yet. Water access is very important — it lets you send boats, build ports and trade by sea. Expand your territory until it reaches the coast.", values = { ["pl"] = "Nie masz jeszcze wybrzeża. Dostęp do wody jest bardzo ważny – pozwala wysyłać łodzie, budować porty i handlować. Rozszerzaj terytorium, aż dotrzesz do brzegu.", ["de"] = "Du hast noch keine Küste. Wasserzugang ist sehr wichtig — er ermöglicht dir Boote zu schicken, Häfen zu bauen und über See zu handeln. Erweitere dein Territorium, bis es die Küste erreicht.", ["fr"] = "Vous n’avez pas encore d'accès à l'eau. L’accès à la mer est très important : il vous permet d’envoyer des bateaux, de construire des ports et de commercer par voie maritime. Étendez votre territoire jusqu’à atteindre un littoral.", ["ru"] = "У вас нет береговой линии. Доступ к воде очень важен — он позволяет спускать корабли, строить порты и вести морскую торговлю. Расширяйте свою территорию, пока не выйдете к побережью.", ["ja"] = "まだあなたの領地は海岸線がありません。海へのアクセスは非常に重要です。海岸線があれば、ボートを送り、港を建設し、海上貿易ができます。領土を海岸まで拡大しましょう。", ["ko"] = "아직 해안선이 없습니다. 바다에 접하는 것은 매우 중요합니다 — 배를 보내고 항구를 건설하며 해상 무역을 할 수 있게 해줍니다. 해안에 닿을 때까지 영토를 확장하세요.", ["vi"] = "Bạn chưa có đường bờ biển. Khả năng tiếp cận đường biển rất quan trọng — nó cho phép bạn gửi thuyền, xây cảng và giao thương bằng đường biển. Hãy mở rộng lãnh thổ cho đến khi chạm tới bờ biển.", ["zh-tw"] = "您還沒有海岸線。水域通行至關重要──可以讓您派出船隻、建造港口、和進行海上貿易。請繼續拓展您的領土直到達到海岸線。" } },
	{ key = "tutorial.complete", source = "You're ready! Good luck out there.", values = { ["pl"] = "Jesteś gotowy! Powodzenia.", ["de"] = "Du bist bereit! Viel Glück.", ["fr"] = "Vous êtes prêt ! Bonne chance.", ["ru"] = "Вы готовы! Удачи.", ["ja"] = "準備ができました！幸運を祈ります。", ["ko"] = "준비가 끝났습니다! 건투를 빕니다.", ["vi"] = "Bạn đã sẵn sàng! Chúc may mắn nhé.", ["zh-tw"] = "您已經準備就緒！祝您武運昌隆。" } },
	{ key = "rbx.127", source = "You: {games} matches, {wins} wins, best {best}% of the map", values = { ["pl"] = "Ty: {games} meczów, {wins} wygranych, najlepiej {best}% mapy" } },
	{ key = "tutorial.step.silo_loading", source = "Your Missile Silo is loading — a nuke can be launched once it's fully ready.", values = { ["pl"] = "Silos rakietowy się ładuje – bombę można wystrzelić, gdy będzie gotowy.", ["de"] = "Dein Raketensilo lädt — ein Nuklearschlag kann gestartet werden, sobald es vollständig bereit ist.", ["fr"] = "Votre silo à missiles est en cours de rechargement : un missile pourra être lancé lorsque le temps de recharge prendra fin.", ["ru"] = "Ваша ракетная шахта перезаряжается. Запуск ядерного удара будет возможен после полной готовности.", ["ja"] = "ミサイルサイロを準備中です。完全に準備が完了すると、核兵器を発射できます。", ["ko"] = "미사일 발사대를 장전 중입니다 — 완전히 준비되면 핵을 발사할 수 있습니다.", ["vi"] = "Hầm phóng tên lửa của bạn đang nạp — có thể phóng tên lửa khi nó đã sẵn sàng hoàn toàn.", ["zh-tw"] = "您的飛彈發射井仍在裝填──當其準備完成時，核彈將可被發射。" } },
	{ key = "events_display.alliance_expired", source = "Your alliance with {name} expired", values = { ["pl"] = "Twój sojusz z {name} wygasł", ["de"] = "Deine Allianz mit {name} ist abgelaufen", ["fr"] = "Votre alliance avec {name} a expiré", ["pt"] = "A sua aliança com {name} expirou", ["ru"] = "Ваш союз с {name} закончился", ["ja"] = "{name}との同盟は失効しました", ["ko"] = "{name}와(과)의 동맹이 만료되었습니다", ["vi"] = "Liên minh của bạn với {name} đã hết hiệu lực", ["zh-tw"] = "你與 {name} 的結盟已過期" } },
	{ key = "events_display.about_to_expire", source = "Your alliance with {name} is about to expire!", values = { ["pl"] = "Twój sojusz z {name} zaraz wygaśnie!", ["de"] = "Deine Allianz mit {name} läuft bald ab!", ["fr"] = "Votre alliance avec {name} est sur le point d'expirer!", ["pt"] = "A sua aliança com {name} está próxima de expirar!", ["ru"] = "Ваш союз с {name} скоро закончится!", ["ja"] = "{name}との同盟は間もなく失効します！", ["ko"] = "{name}와(과)의 동맹이 곧 만료됩니다!", ["vi"] = "Liên minh giữa bạn và {name} sắp hết hiệu lực!", ["zh-tw"] = "你與 {name} 的結盟即將到期！" } },
	{ key = "rbx.128", source = "Your profile is still loading…", values = { ["pl"] = "Twój profil jeszcze się ładuje…" } },
	{ key = "tutorial.step.launch_atom", source = "Your silo is armed! Press {key}, then click a neighbor's territory to launch an Atom Bomb.", values = { ["pl"] = "Silos uzbrojony! Naciśnij {key}, a potem kliknij terytorium sąsiada, aby wystrzelić bombę atomową.", ["de"] = "Dein Silo ist bewaffnet! Drücke {key} und klicke dann auf das Territorium eines Nachbarn, um eine Atombombe zu starten.", ["fr"] = "Votre silo est paré à faire feu ! Appuyez sur {key}, puis cliquez sur le territoire d’un voisin pour lancer une bombe atomique.", ["ru"] = "Ваша шахта заряжена! Нажмите {key}, а затем кликните по территории соседа, чтобы запустить атомную бомбу.", ["ja"] = "ミサイルサイロの準備が完了しましたね！{key}を押してから、隣接する国家の領土を左クリックして原子爆弾を発射しましょう。", ["ko"] = "발사대가 준비되었습니다! {key} 키를 누른 다음, 인접국의 영토를 클릭하여 원자 폭탄을 발사하세요.", ["vi"] = "Hầm phóng tên lửa của bạn đã sẵn sàng! Nhấn {key}, sau đó bấm vào lãnh thổ của một nước láng giềng để phóng Tên lửa bom nguyên tử.", ["zh-tw"] = "您的發射井已武裝完畢！按 {key}，然後點擊在鄰居的領土即可發射一枚核彈。" } },
	{ key = "tutorial.step_touch.launch_atom", source = "Your silo is armed! Tap a neighbor's territory, open the sword menu and pick Atom Bomb.", values = { ["pl"] = "Silos uzbrojony! Dotknij terytorium sąsiada, otwórz menu miecza i wybierz bombę atomową.", ["de"] = "Dein Silo ist bewaffnet! Tippe auf das Territorium eines Nachbarn, öffne das Schwert‑Menü und wähle ‚Atombombe‘.", ["fr"] = "Votre silo est paré à faire feu ! Touchez le territoire d'un voisin, ouvrez le menu de combat, puis sélectionnez l'icône nucléaire.", ["ru"] = "Ваша ракетная шахта готова! Коснитесь территории соседа, откройте меню с мечом и выберите «Атомная бомба».", ["ja"] = "ミサイルサイロの準備が完了しました！隣接する国家の領土をクリックして剣メニューを開き水素爆弾を撃ちましょう。", ["ko"] = "발사대가 준비되었습니다! 인접국의 영토를 탭하고 검 메뉴를 연 다음 원자 폭탄을 선택하세요.", ["vi"] = "Hầm phóng tên lửa của bạn đã sẵn sàng! Nhấn vào lãnh thổ của một nước láng giềng, mở menu hình cây kiếm và chọn Bom nguyên tử.", ["zh-tw"] = "您的發射井已武裝完畢！點擊鄰居的領土，開啟攻擊選單並選擇核彈即可發射一枚核彈。" } },
	{ key = "win_modal.your_team", source = "Your team won!", values = { ["pl"] = "Twoja drużyna wygrała!", ["de"] = "Dein Team hat gewonnen!", ["fr"] = "Votre équipe a gagné !", ["pt"] = "Sua Equipe Venceu!", ["ru"] = "Ваша команда победила!", ["ja"] = "あなたのチームの勝利！", ["ko"] = "우리팀이 승리했습니다!", ["vi"] = "Đội của bạn đã thắng!", ["zh-tw"] = "你的隊伍獲勝了！" } },
	{ key = "events_display.trade_ship_captured", source = "Your trade ship was captured by {name}", values = { ["pl"] = "Twój statek handlowy został przejęty przez {name}", ["de"] = "Dein Handelsschiff wurde von {name} erobert", ["fr"] = "Votre bateau de commerce a été capturé par {name}", ["pt"] = "O teu navio de troca foi capturado por {name}", ["ru"] = "{name} захватывает ваш торговый корабль", ["ja"] = "あなたの貿易船は{name}に鹵獲されました", ["ko"] = "{name}님에게 무역선이 나포되었습니다", ["vi"] = "Tàu giao thương của bạn đã bị {name} bắt giữ", ["zh-tw"] = "你的商船已被 {name} 擄獲" } },
