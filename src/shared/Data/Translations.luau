	{ key = "tutorial.step.attack_ratio", source = "The attack ratio bar sets how many of your troops are sent out with each attack. Drag the slider to adjust it.", values = { ["pl"] = "Pasek siły ataku ustala, ile wojska wysyłasz w każdym ataku. Przeciągnij suwak, aby to zmienić.", ["de"] = "Der Angriffs‑Ratio‑Balken legt fest, wie viele deiner Truppen bei jedem Angriff ausgesendet werden. Ziehe den Schieberegler, um ihn anzupassen.", ["fr"] = "La barre du ratio d’attaque détermine la quantité de troupes que vous envoyez à chaque attaque. Faites glisser le curseur pour l’ajuster.", ["ru"] = "Шкала соотношения атаки определяет, сколько войск отправляется в бой при каждом наступлении. Перетаскивайте ползунок для настройки.", ["ja"] = "攻撃比率バーでは、1回の攻撃で送り出す兵士の割合を設定できます。スライダーを動かして調整してください。", ["ko"] = "공격 비율 막대는 공격할 때마다 보낼 병력의 양을 설정합니다. 슬라이더를 드래그하여 조절하세요.", ["vi"] = "Thanh tỷ lệ tấn công quyết định số quân được gửi đi trong mỗi đòn tấn công. Kéo thanh trượt để điều chỉnh.", ["zh-tw"] = "攻擊比例條顯示每次攻擊將派出多少您的軍隊。拖曳控制條以調整。" } },
	{ key = "tutorial.step.attack_wilderness", source = "The pulsing ring marks your territory. Click on the unclaimed land next to it to attack and expand.", values = { ["pl"] = "Pulsujący pierścień oznacza twoje terytorium. Kliknij wolny teren obok, aby zaatakować i się rozszerzyć.", ["de"] = "Der pulsierende Ring markiert dein Territorium. Klicke auf das unbeanspruchte Land daneben, um anzugreifen und dich auszubreiten.", ["fr"] = "L’anneau lumineux qui pulse indique votre territoire. Cliquez sur les territoires non revendiqués aux alentours pour attaquer et vous étendre.", ["ru"] = "Пульсирующее кольцо обозначает вашу территорию. Кликните по соседним ничейным землям, чтобы атаковать и расширить границы.", ["ja"] = "点滅で囲まれた領土が自分の領土を示しています。隣接している未領有地をクリックして攻撃し、領土を拡大しましょう。", ["ko"] = "깜빡이는 원은 영토를 나타냅니다. 인접한 미점유 토지를 클릭하여 공격하고 확장하세요.", ["vi"] = "Vòng tròn nhấp nháy đánh dấu lãnh thổ của bạn. Nhấn vào vùng đất chưa có chủ bên cạnh để tấn công và mở rộng.", ["zh-tw"] = "閃爍的圓環顯示的是您的領土。在圓環旁的無主領土上點擊即可攻擊並擴展您的領土。" } },
	{ key = "tutorial.step_touch.attack_wilderness", source = "The pulsing ring marks your territory. Tap the unclaimed land next to it, then tap the sword in the middle of the menu to attack.", values = { ["pl"] = "Pulsujący pierścień oznacza twoje terytorium. Dotknij wolnego terenu obok, a potem miecza na środku menu, aby zaatakować.", ["de"] = "Der pulsierende Ring markiert dein Territorium. Tippe auf das unbeanspruchte Land daneben und tippe dann auf das Schwert in der Mitte des Menüs, um anzugreifen.", ["fr"] = "L’anneau lumineux qui pulse indique votre territoire. Touchez les territoires non revendiqués aux alentours pour les attaquer et vous étendre.", ["ru"] = "Пульсирующее кольцо обозначает вашу территорию. Коснитесь соседних ничейных земель, а затем нажмите на меч в центре меню, чтобы атаковать.", ["ja"] = "点滅している囲まれたエリアは、あなたの領土です。その隣にある未占領(中立状態)の土地を右クリックして選択し、円形メニューの中央にある「剣のアイコン」を左クリックして攻撃しましょう。", ["ko"] = "깜빡이는 원은 영토를 나타냅니다. 인접한 미점유 토지를 탭한 다음, 메뉴 중앙의 검을 탭하여 공격하세요.", ["vi"] = "Vòng tròn nhấp nháy đánh dấu lãnh thổ của bạn. Nhấn vào vùng đất chưa có chủ bên cạnh, sau đó nhấn vào cây kiếm ở giữa menu để tấn công.", ["zh-tw"] = "閃爍的圓環顯示的是您的領土。在圓環旁的無主領土上點擊，然後點擊選單中間的選項即可攻擊。" } },
	{ key = "tutorial.step.troop_rate", source = "This is your troop growth rate. Growth slows down and turns orange once your troops approach half of your max.", values = { ["pl"] = "To tempo przyrostu wojska. Przyrost zwalnia i robi się pomarańczowy, gdy wojsko zbliża się do połowy limitu.", ["de"] = "Dies ist deine Truppenwachstumsrate. Das Wachstum verlangsamt sich und wird orange, sobald sich deine Truppen der Hälfte deines Maximums nähern.", ["fr"] = "Voici votre taux de croissance des troupes. La croissance ralentit et devient orange lorsque vos troupes approchent de la moitié de votre maximum.", ["ru"] = "Это скорость прироста ваших войск. Прирост замедляется, а индикатор становится оранжевым, когда численность войск приближается к половине от максимума.", ["ja"] = "これは兵力の増加速度です。兵力が兵力上限の半分に近づくと、増加速度が低下してオレンジ色になります。", ["ko"] = "현재 병력 증가율입니다. 병력이 최대치의 절반에 가까워지면 증가 속도가 느려지고 주황색으로 바뀝니다.", ["vi"] = "Đây là tốc độ tăng quân của bạn. Tốc độ sẽ chậm lại và chuyển sang màu cam khi quân của bạn gần đạt một nửa mức tối đa.", ["zh-tw"] = "這是您的軍隊成長速度。一旦您的軍隊接近上限的一半，成長速度會降低並轉為橘色。" } },
