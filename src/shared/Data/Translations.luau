	{ key = "tutorial.step.attack_nations", source = "Nations have cut you off from the tribes. Attack a neighboring nation instead — they're stronger than tribes, so bring plenty of troops. The nearest ones are marked with a target. Conquer them until you have {cost} gold for a City.", values = { ["pl"] = "Narody odcięły cię od plemion. Zaatakuj sąsiedni naród – jest silniejszy od plemion, więc weź dużo wojska. Najbliższe są oznaczone celownikiem. Podbijaj, aż uzbierasz {cost} złota na Miasto.", ["de"] = "Nationen haben dich von den Stämmen abgeschnitten. Greife stattdessen eine benachbarte Nation an — sie sind stärker als Stämme, also bring viele Truppen mit. Die nächstgelegenen sind mit einem Fadenkreuz markiert. Erobere sie, bis du {cost} Gold für eine Stadt hast.", ["fr"] = "Les Nations vous empêchent d’atteindre des tribus. Attaquez plutôt une nation voisine — elles sont plus puissantes que les tribus, alors prévoyez suffisamment de troupes. Les plus proches sont signalées par une cible. Éliminez-les jusqu’à obtenir {cost} or pour construire une Ville.", ["ru"] = "Другие нации отрезали вас от племён. Вместо этого атакуйте соседние нации — они сильнее племён, так что берите побольше войск. Ближайшие цели отмечены мишенью. Завоёвывайте их, пока не накопите {cost} золота на постройку города.", ["ja"] = "国家によって部族へ攻撃する手段がなくなりました。隣接する国家を攻撃しましょう。国家は部族より強いので、十分な兵士を用意してください。最も近い国家にターゲットが表示されています。都市を建設できる{cost}資金が貯まるまで征服しましょう。", ["ko"] = "국가들이 부족으로 가는 길을 차단했습니다. 대신 인접한 국가를 공격하세요 — 부족보다 강하므로 많은 병력을 데려가세요 . 가장 가까운 대상에는 표적이 표시됩니다. 도시를 건설할 금 {cost}을(를) 모을 때까지 정복하세요 .", ["vi"] = "Các quốc gia đã cắt đứt bạn khỏi các bộ tộc. Hãy tấn công quốc gia láng giềng — chúng mạnh hơn bộ tộc, nên hãy mang theo nhiều quân. Những quốc gia gần nhất được đánh dấu bằng mục tiêu. Hãy chinh phục chúng cho đến khi bạn có {cost} vàng để xây Thành phố.", ["zh-tw"] = "國家已將您與其他部族隔開。請改為攻擊鄰近的國家──他們的實力比部族還要強，建議使用更多的兵力攻擊。最近的國家已在地圖上被標記。當您擁有 {cost} 黃金以建造城市後再征服他們。" } },
	{ key = "tutorial.step.propose_alliance", source = "Nations make strong allies. Right-click the nation marked with a target and propose an alliance.", values = { ["pl"] = "Narody to silni sojusznicy. Kliknij prawym przyciskiem naród oznaczony celownikiem i zaproponuj sojusz.", ["de"] = "Nationen sind starke Verbündete. Klicke mit der rechten Maustaste auf die mit einem Fadenkreuz markierte Nation und schlage ein Bündnis vor.", ["fr"] = "Les nations peuvent devenir de puissants alliés. Faites un clic droit sur la nation indiquée par une cible et proposez-lui une alliance.", ["ru"] = "Из наций получаются сильные союзники. Кликните правой кнопкой мыши по отмеченной нации и предложите союз.", ["ja"] = "国家は強力な同盟国にもなります。ターゲットが表示された国家を右クリックして円形メニューを開き、下の「同盟」をクリックして提案してみましょう。", ["ko"] = "국가는 든든한 동맹이 됩니다. 표적이 표시된 국가를 우클릭하여 동맹을 제안하세요.", ["vi"] = "Các quốc gia là đồng minh mạnh mẽ. Nhấp chuột phải vào quốc gia được đánh dấu mục tiêu và đề xuất liên minh.", ["zh-tw"] = "與其他國家結盟將帶來更強的盟友。右鍵點擊被標記的國家並向其提出結盟請求。" } },
	{ key = "tutorial.step_touch.propose_alliance", source = "Nations make strong allies. Tap the nation marked with a target, then tap the handshake to propose an alliance.", values = { ["pl"] = "Narody to silni sojusznicy. Dotknij narodu oznaczonego celownikiem, a potem uścisku dłoni, aby zaproponować sojusz.", ["de"] = "Nationen sind starke Verbündete. Tippe auf die mit einem Fadenkreuz markierte Nation und tippe dann auf den Handschlag, um ein Bündnis vorzuschlagen.", ["fr"] = "Les nations peuvent devenir de puissants alliés. Touchez la nation indiquée par une cible, puis l’icône de poignée de main pour leur proposer une alliance.", ["ru"] = "Из наций получаются сильные союзники. Коснитесь отмеченной нации и нажмите на рукопожатие, чтобы предложить союз.", ["ja"] = "国家は味方にすれば強力です。ターゲットマークがついている国家の領土で右クリックし、緑色の同盟アイコンをクリックして同盟を提案しましょう。", ["ko"] = "국가는 든든한 동맹이 됩니다. 표적이 표시된 국가를 탭한 다음, 악수를 탭하여 동맹을 제안하세요.", ["vi"] = "Các quốc gia là đồng minh mạnh mẽ. Nhấn vào quốc gia được đánh dấu mục tiêu, sau đó nhấn vào biểu tượng bắt tay để đề xuất liên minh.", ["zh-tw"] = "與其他國家結盟將帶來更強的盟友。點擊被標記的國家，然後點擊握手圖示以向其提出結盟請求。" } },
	{ key = "relation.neutral", source = "Neutral", values = { ["pl"] = "Neutralne", ["fr"] = "Neutre", ["pt"] = "Neutro", ["ru"] = "Нейтральное", ["ja"] = "中立", ["ko"] = "중립", ["vi"] = "Trung lập", ["zh-tw"] = "中立" } },
	{ key = "rbx.66", source = "New match starting soon", values = { ["pl"] = "Nowy mecz wkrótce" } },
	{ key = "rbx.67", source = "Next match", values = { ["pl"] = "Następny mecz" } },
	{ key = "tutorial.step.buy_port", source = "Next, build a Port: press {key}, then click your coastline to place it.", values = { ["pl"] = "Teraz zbuduj Port: naciśnij {key}, a potem kliknij swoje wybrzeże.", ["de"] = "Als Nächstes baust du einen Hafen: Drücke {key} und klicke dann auf deine Küste, um ihn zu platzieren.", ["fr"] = "Ensuite, construisez un Port : appuyez sur {key}, puis cliquez sur votre littoral ou dans une rivière pour l'y placer.", ["ru"] = "Теперь постройте порт: нажмите {key}, а затем кликните по свей береговой линии, чтобы разместить его.", ["ja"] = "港を建設しましょう。{key}を押してから、自分の海岸線を左クリックして建設してください。", ["ko"] = "다음으로 항구를 건설하세요: {key} 키를 누른 다음, 해안선을 클릭하여 배치하세요.", ["vi"] = "Tiếp theo, hãy xây Cảng: nhấn {key}, sau đó bấm vào đường bờ biển của bạn để đặt nó.", ["zh-tw"] = "接著，建造一個港口：按 {key}，然後點擊在您的海岸線上即可建造。" } },
	{ key = "tutorial.step_touch.buy_port", source = "Next, build a Port: tap your coastline, open the wrench menu and pick Port.", values = { ["pl"] = "Teraz zbuduj Port: dotknij wybrzeża, otwórz menu klucza i wybierz Port.", ["de"] = "Als Nächstes baust du einen Hafen: Tippe auf deine Küste, öffne das Schraubenschlüssel‑Menü und wähle ‚Hafen‘.", ["fr"] = "Ensuite, construisez un Port : touchez votre littoral, ouvrez le menu Construction, puis sélectionnez l'icône d'ancre.", ["ru"] = "Далее, постройте порт: коснитесь своего берега, откройте меню с гаечным ключом и выберите «Порт».", ["ja"] = "次に、港を建築しましょう：海岸線を右クリックし、円形メニューを開き、港を選択します。", ["ko"] = "다음으로 항구를 건설하세요: 해안선을 탭하고 렌치 메뉴를 연 다음 항구를 선택하세요.", ["vi"] = "Tiếp theo, hãy xây Cảng: nhấn vào đường bờ biển của bạn, mở menu hình cờ lê và chọn Cảng.", ["zh-tw"] = "接著，建造一個港口：點擊在您的海岸線上，開啟扳手選單並選擇港口即可建造。" } },
	{ key = "events_display.no_boats_available", source = "No boats available, max {max}", values = { ["pl"] = "Brak wolnych łodzi, maksimum {max}", ["de"] = "Keine Boote verfügbar, max. {max}", ["fr"] = "Aucun bateau disponible, max {max}", ["pt"] = "Sem barcos disponíveis, máximo {max}", ["ru"] = "Нет доступных судов, максимум — {max}", ["ja"] = "輸送船をこれ以上出せません、最大は{max}隻までです", ["ko"] = "배를 사용할 수 없습니다. 최대 {max}대", ["vi"] = "Không có tàu có sẵn, tối đa {max}", ["zh-tw"] = "沒有可用的運輸船，最多 {max} 個" } },
	{ key = "rbx.68", source = "No private match with that code.", values = { ["pl"] = "Nie ma prywatnego meczu z tym kodem." } },
	{ key = "common.none", source = "None", values = { ["pl"] = "Brak", ["de"] = "Nichts", ["fr"] = "Aucun", ["pt"] = "Nenhum", ["ru"] = "Ничего", ["ja"] = "なし", ["ko"] = "없음", ["vi"] = "Trống", ["zh-tw"] = "沒有任何" } },
	{ key = "map.northamerica", source = "North America", values = { ["pl"] = "Ameryka Północna", ["de"] = "Nordamerika", ["fr"] = "Amérique du Nord", ["pt"] = "América do Norte", ["ru"] = "Северная Америка", ["ja"] = "北アメリカ", ["ko"] = "북미", ["vi"] = "Bắc Mỹ", ["zh-tw"] = "北美洲" } },
	{ key = "tutorial.step.buy_defense_post", source = "Now build a Defense Post: press {key}, then click your territory near a border. Attacks on the land around it are much slower and cost the enemy far more troops.", values = { ["pl"] = "Teraz zbuduj Posterunek obronny: naciśnij {key}, a potem kliknij swoje terytorium przy granicy. Ataki na teren wokół niego są dużo wolniejsze i kosztują wroga znacznie więcej wojska.", ["de"] = "Baue jetzt einen Verteidigungsposten: Drücke {key} und klicke dann auf dein Territorium in Grenznähe. Angriffe auf das umliegende Land werden dadurch deutlich verlangsamt und kosten den Gegner viel mehr Truppen.", ["fr"] = "Construisez maintenant un Poste de Défense : appuyez sur {key}, puis cliquez sur votre territoire près d’une frontière pour l'y construire. Les attaques contre les terres alentour sont beaucoup plus lentes et coûtent bien plus de troupes à l’ennemi.", ["ru"] = "Теперь постройте укрепление: нажмите {key}, а затем кликните по своей территории рядом с границей. Захват земель вокруг него будет происходить гораздо медленнее, а враг потеряет значительно больше войск.", ["ja"] = "防衛ポストを建設しましょう。{key}を押してから、国境付近の自分の領土へ左クリックしてください。要塞周辺の土地への攻撃は大幅に遅くなり、敵の兵士もより多く消費させられます。", ["ko"] = "이제 방어 초소를 건설하세요: {key} 키를 누른 다음, 국경 근처의 영토를 클릭하세요. 주변 토지에 대한 공격 속도가 크게 느려지며 적에게 훨씬 더 많은 병력 소모를 강요합니다.", ["vi"] = "Giờ hãy xây Chốt phòng thủ: nhấn {key}, sau đó bấm vào lãnh thổ của bạn gần biên giới. Các đòn tấn công vào vùng đất xung quanh nó sẽ chậm hơn nhiều và khiến địch tốn nhiều quân hơn.", ["zh-tw"] = "現在，建造一個防禦哨所：按 {key}，然後點擊在您領土的邊界。在陸地上，防禦哨所周圍的攻擊會比較慢，也會造成敵人損失更多的軍隊。" } },
	{ key = "tutorial.step_touch.buy_defense_post", source = "Now build a Defense Post: tap your territory near a border, open the wrench menu and pick Defense Post. Attacks on the land around it are much slower and cost the enemy far more troops.", values = { ["pl"] = "Teraz zbuduj Posterunek obronny: dotknij terytorium przy granicy, otwórz menu klucza i wybierz Posterunek obronny. Ataki na teren wokół niego są dużo wolniejsze i kosztują wroga znacznie więcej wojska.", ["de"] = "Baue jetzt einen Verteidigungsposten: Tippe auf dein Territorium nahe einer Grenze, öffne das Schraubenschlüssel‑Menü und wähle ‚Verteidigungsposten‘. Angriffe auf das umliegende Land werden dadurch deutlich verlangsamt und kosten den Gegner viel mehr Truppen.", ["fr"] = "Construisez maintenant un Poste de Défense : touchez votre territoire près d’une frontière, ouvrez le menu Construction, puis sélectionnez l'icône de bouclier. Les attaques sur les terres aux alentours sont beaucoup plus lentes et coûtent bien plus de troupes à l’ennemi.", ["ru"] = "Теперь постройте укрепление: коснитесь своей территории у границы, откройте меню с гаечным ключом и выберите «Укрепление». Захват земель вокруг него будет происходить гораздо медленнее, а враг потеряет значительно больше войск.", ["ja"] = "防衛ポストを作りましょう。国境付近にある自分の領土を右クリックして円形メニューを開き、「防衛ポスト」を選択します。防衛ポストの近くでは、敵の陸上部隊の進軍スピードが大幅に低下するだけでなく、敵の兵力をより多く消耗させることができます。", ["ko"] = "이제 방어 진지를 건설하세요: 국경 근처의 영토를 탭하고 렌치 메뉴를 연 다음 방어 진지를 선택하세요. 주변 토지에 대한 공격 속도가 크게 느려지며 적에게 훨씬 더 많은 병력 소모를 강요합니다.", ["vi"] = "Giờ hãy xây Chốt phòng thủ: nhấn vào lãnh thổ của bạn gần biên giới, mở menu hình cờ lê và chọn Chốt phòng thủ. Các đòn tấn công vào vùng đất xung quanh nó sẽ chậm hơn nhiều và khiến địch tốn nhiều quân hơn.", ["zh-tw"] = "現在，建造一個防禦哨所：點擊您領土的邊界上，開啟扳手選單並選擇防禦哨所即可建造。在陸地上，防禦哨所周圍的攻擊會比較慢，也會造成敵人損失更多的軍隊。" } },
	{ key = "tutorial.step.buy_factory", source = "Now build a Factory: press {key}, then click your territory to place it.", values = { ["pl"] = "Teraz zbuduj Fabrykę: naciśnij {key}, a potem kliknij swoje terytorium.", ["de"] = "Baue jetzt eine Fabrik: Drücke {key} und klicke dann auf dein Territorium, um sie zu platzieren.", ["fr"] = "Construisez maintenant une Usine : cliquez sur {key}, puis cliquez sur votre territoire pour la placer de telle sorte qu'elle relie d'autres bâtiments.", ["ru"] = "Теперь постройте фабрику: нажмите {key}, а затем кликните по своей территории, чтобы разместить её.", ["ja"] = "工場を建設しましょう。{key}を押してから、自分の領土に左クリックして建設してください。", ["ko"] = "이제 공장을 건설하세요: {key} 키를 누른 다음, 영토를 클릭하여 배치하세요.", ["vi"] = "Giờ hãy xây Nhà máy: nhấn {key}, sau đó bấm vào lãnh thổ của bạn để đặt nó.", ["zh-tw"] = "現在，建造一個工廠：按 {key}，然後點擊在您的領土即可建造。" } },
	{ key = "tutorial.step_touch.buy_factory", source = "Now build a Factory: tap your territory, open the wrench menu and pick Factory.", values = { ["pl"] = "Teraz zbuduj Fabrykę: dotknij terytorium, otwórz menu klucza i wybierz Fabrykę.", ["de"] = "Baue jetzt eine Fabrik: Tippe auf dein Gebiet, öffne das Schraubenschlüssel‑Menü und wähle ‚Fabrik‘.", ["fr"] = "Construisez maintenant une Usine : touchez votre territoire pour la placer de telle sorte qu'elle relie d'autres bâtiments, ouvrez le menu Construction puis sélectionnez l'icône d'usine.", ["ru"] = "Теперь постройте фабрику: коснитесь своей территории, откройте меню инструментов и выберите «Фабрика».", ["ja"] = "あ", ["ko"] = "이제 공장을 건설하세요: 영토를 탭하고 렌치 메뉴를 연 다음 공장을 선택하세요.", ["vi"] = "Giờ hãy xây Nhà máy: nhấn vào lãnh thổ của bạn, mở menu hình cờ lê và chọn Nhà máy.", ["zh-tw"] = "現在，建造一個工廠：點擊您的領土，開啟扳手選單並選擇工廠即可建造。" } },
	{ key = "tutorial.step.buy_warship", source = "Now build a Warship: press {key}, then click open water near your port. Warships capture trade ships and protect your waters.", values = { ["pl"] = "Teraz zbuduj Okręt wojenny: naciśnij {key}, a potem kliknij otwartą wodę przy porcie. Okręty przejmują statki handlowe i chronią twoje wody.", ["de"] = "Baue jetzt ein Kriegsschiff: Drücke {key} und klicke dann auf offenes Wasser in der Nähe deines Hafens. Kriegsschiffe kapern Handelsschiffe und schützen deine Gewässer.", ["fr"] = "Construisez maintenant un Navire de guerre : appuyez sur {key}, puis cliquez en pleine mer près de votre port. Les navires de guerre capturent des bateaux de commerce et protègent vos côtes contre les transports ennemis.", ["ru"] = "Теперь постройте военный корабль: нажмите {key}, а затем кликните по открытой воде рядом с вашим портом. Военные корабли захватывают торговые суда и защищают ваши воды.", ["ja"] = "戦艦を発艦させましょう。{key}を押してから、港の近くの海を左クリックしてください。戦艦は貿易船を鹵獲し、自国の近くの海域を守る役割をしてくれます。", ["ko"] = "이제 군함을 건조하세요: {key} 키를 누른 다음, 항구 근처의 트인 수역을 클릭하세요. 군함은 무역선을 나포하고 영해를 보호합니다.", ["vi"] = "Giờ hãy đóng một Tàu chiến: nhấn {key}, sau đó bấm vào vùng nước trống gần cảng của bạn. Tàu chiến bắt tàu thương mại và bảo vệ vùng biển của bạn.", ["zh-tw"] = "現在，建造一個軍艦：按 {key}，然後點擊在鄰近您港口的開放水域即可部署。軍艦可以擄獲商船和保護您的水域。" } },
	{ key = "tutorial.step_touch.buy_warship", source = "Now build a Warship: tap open water near your port, open the sword menu and pick Warship. Warships capture trade ships and protect your waters.", values = { ["pl"] = "Teraz zbuduj Okręt wojenny: dotknij otwartej wody przy porcie, otwórz menu miecza i wybierz Okręt wojenny. Okręty przejmują statki handlowe i chronią twoje wody.", ["de"] = "Baue jetzt ein Kriegsschiff: Tippe auf offenes Wasser in der Nähe deines Hafens, öffne das Schwert‑Menü und wähle ‚Kriegsschiff‘. Kriegsschiffe kapern Handelsschiffe und schützen deine Gewässer.", ["fr"] = "Construisez maintenant un Navire de guerre : touchez la mer près de votre port, ouvrez le menu de combat, puis sélectionnez l'icône de bateau. Les navires de guerre capturent des bateaux de commerce et protègent vos côtes contre les transports ennemis.", ["ru"] = "Теперь постройте военный корабль: коснитесь открытой воды рядом с вашим портом, откройте меню с мечом и выберите «Военный корабль». Военные корабли захватывают торговые суда и защищают ваши воды.", ["ja"] = "戦艦を発艦しましょう。", ["ko"] = "이제 군함을 건조하세요: 항구 근처의 트인 수역을 탭하고 검 메뉴를 연 다음 군함을 선택하세요. 군함은 무역선을 나포하고 영해를 보호합니다.", ["vi"] = "Giờ hãy đóng Tàu chiến: nhấn vào vùng nước trống gần cảng của bạn, mở menu hình cây kiếm và chọn Tàu chiến. Tàu chiến bắt tàu thương mại và bảo vệ vùng biển của bạn.", ["zh-tw"] = "現在，建造一個軍艦：點擊在鄰近您港口的開放水域，開啟攻擊選單並選擇軍艦即可部署。軍艦可以擄獲商船和保護您的水域。" } },
